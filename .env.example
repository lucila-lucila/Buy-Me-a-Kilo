# ---------------------------------------------------------------------------
# Ninguna de estas variables lleva prefijo VITE_. Vite inlina en el bundle del
# cliente cualquier cosa que lo lleve, y toda esta capa es solo del servidor.
# scripts/check-leak.mjs falla el build si algo de acá aparece en dist/.
# ---------------------------------------------------------------------------

# Ko-fi -> Settings -> API. El webhook rechaza con 401 si no coincide.
KOFI_VERIFICATION_TOKEN=

# Vercel KV / Upstash Redis. Vercel las inyecta solas si conectás el store.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Dashboard privado: /api/stats?key=... Sin key válida devuelve 404.
# Que sea largo y aleatorio: es la única puerta.
STATS_SECRET=

# El usuario de Ko-fi NO va acá: es público y vive en src/config/tiers.ts, en la
# constante KOFI_USERNAME. Una env var sin prefijo VITE_ no llega al navegador,
# así que cargarlo en Vercel no hace nada.

# direct_link_code de cada item de Ko-fi (ko-fi.com/s/<code>).
# Solo hacen falta si querés corregir un código sin redeploy; por defecto se
# usan los de src/config/tiers.ts.
KOFI_ITEM_ONE=
KOFI_ITEM_THREE=
KOFI_ITEM_CARRY=
KOFI_ITEM_OVERWEIGHT=

# Comisiones, para ajustar cuando veas las reales en el panel de Ko-fi.
KOFI_PCT=0.05
PAYPAL_PCT=0.029
PAYPAL_FIXED_CENTS=49
# Envío del sticker físico del tier de overweight.
OVERWEIGHT_SHIPPING_CENTS=1050

# El neto promedio esperado por aporte NO se carga: el dashboard lo calcula desde
# la mezcla esperada y las comisiones de arriba, así que no puede quedar viejo.

# Escenarios internos, en aportes por semana.
TARGET_FLOOR_WEEKLY=60
TARGET_REAL_WEEKLY=200
TARGET_JACKPOT_WEEKLY=1500

# Horizonte de la proyección del dashboard.
WEEKS_REMAINING=12

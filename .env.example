# ---------------------------------------------------------------------------
# Ninguna de estas variables lleva prefijo VITE_. Vite inlina en el bundle del
# cliente cualquier cosa que lo lleve, y toda esta capa es solo del servidor.
# scripts/check-leak.mjs falla el build si algo de acá aparece en dist/.
# ---------------------------------------------------------------------------

# Ko-fi -> Settings -> API. El webhook rechaza con 401 si no coincide.
KOFI_VERIFICATION_TOKEN=

# Vercel KV / Upstash Redis. Vercel las inyecta solas si conectás el store.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Dashboard privado: /api/stats?key=... Sin key válida devuelve 404.
# Que sea largo y aleatorio: es la única puerta.
STATS_SECRET=

# El usuario de Ko-fi NO va acá: es público y vive en src/config/kofi.ts. Una env
# var sin prefijo VITE_ no llega al navegador, así que cargarlo no haría nada.
# Los items de tienda se eliminaron: hay un solo botón de monto libre.

# Comisiones, para ajustar cuando veas las reales en el panel de Ko-fi.
KOFI_PCT=0.05
PAYPAL_PCT=0.029
PAYPAL_FIXED_CENTS=49
# No hay envío físico: no se manda nada por correo.

# El neto promedio esperado por aporte NO se carga: el dashboard lo calcula desde
# la mezcla esperada y las comisiones de arriba, así que no puede quedar viejo.

# Escenarios internos, en aportes por semana.
TARGET_FLOOR_WEEKLY=60
TARGET_REAL_WEEKLY=200
TARGET_JACKPOT_WEEKLY=1500

# ---------------------------------------------------------------------------
# El viaje. Estos números SÍ se ven en la página.
# ---------------------------------------------------------------------------

# Arrastre inicial: 289 aportes reales que llegaron por redes antes de que
# existiera esta página. 1309 g salen de 289 personas x 1,51 unidades x 3 g.
# Se suman al leer y no se escriben en KV, así el contador del webhook sigue
# siendo solo lo que pasó acá.
#
# El código tiene estos mismos valores como default. Si las borrás no pasa nada;
# si las ponés en 0, el número de valija retrocede, y la regla es que nunca baja.
SEED_GRAMS=1309
SEED_PEOPLE=289

# Meta interna de personas. Nunca se muestra en la página: solo la usa
# /api/stats para saber a qué porcentaje del objetivo vamos.
TARGET_PEOPLE=5200

# Salida del avión. De acá salen los días que faltan y las semanas de la
# proyección del dashboard. Reemplazó a WEEKS_REMAINING, que ya no existe.
DEPARTURE_DATE=2026-10-11T00:00:00-03:00

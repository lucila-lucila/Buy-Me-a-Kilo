{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    // Igual que Vercel: el package.json declara "type": "module", así que las
    // funciones se compilan como ESM de Node y los imports relativos necesitan
    // extensión explícita. Con "bundler" esto pasaba local y fallaba en el deploy.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo"
  },
  "include": ["api", "src/config/suitcase.ts"]
}
